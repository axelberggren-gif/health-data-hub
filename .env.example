# Copy to .env and fill in. Register your app at https://developer-dashboard.whoop.com
APP_NAME="Health Data Hub"
ENV=dev

# SQLite for local dev. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/health
DATABASE_URL=sqlite:///./health.db

# WHOOP OAuth credentials (from the WHOOP Developer Dashboard)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered on the dashboard.
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# Usually no need to change these:
WHOOP_AUTHORIZE_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_API_BASE=https://api.prod.whoop.com/developer/v2
WHOOP_SCOPES=read:recovery read:cycles read:sleep read:workout read:profile read:body_measurement offline

# --- Mill Sense (indoor air quality) ---
# Uses your Mill app account login (no OAuth / API keys).
MILL_USERNAME=
MILL_PASSWORD=
# MILL_API_BASE=https://api.millnorwaycloud.com

# Optional in-app poller (builds the overnight time series automatically).
# MILL_POLL_ENABLED=true
# MILL_POLL_INTERVAL_SECONDS=300
# MILL_POLL_START_HOUR=22   # only poll 22:00..08:00 (wraps midnight); omit both to poll 24/7
# MILL_POLL_END_HOUR=8
