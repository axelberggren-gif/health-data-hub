# Copy to .env and fill in. Register your app at https://developer-dashboard.whoop.com
APP_NAME="Health Data Hub"
ENV=dev

# SQLite for local dev. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/health
DATABASE_URL=sqlite:///./health.db

# --- App auth ---
# One shared token guarding the data routes (/export today; /dashboard, /log and
# /insights as they land). Leave EMPTY for local-only dev and auth is disabled.
# Set it to a long random string before the app is reachable from anywhere but
# localhost, then call the app once with ?token=<value> so the PWA stores it.
APP_TOKEN=

# --- Home location ---
# The local calendar every daily rollup is bucketed by (IANA timezone name).
HOME_TIMEZONE=Europe/Stockholm
# Coordinates for the weather/daylight source. Left at 0.0 the source stays off and makes
# no network call — Open-Meteo would otherwise answer for 0.0/0.0 (the Gulf of Guinea).
HOME_LAT=0.0
HOME_LON=0.0

# --- Weather (Open-Meteo) ---
# Free and keyless; there is nothing to authenticate. Two hosts: the forecast endpoint
# covers roughly the last 90 days plus the forecast, the archive endpoint deep history.
# Only override these to point at a mirror or a self-hosted instance.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Derived layer (daily rollups, readiness, baselines, flags) ---
# Local computation over data already in the store, so it runs by default: once a day at
# DERIVED_RUN_HOUR local time, plus a catch-up at startup if it has gone stale.
# DERIVED_SCHEDULE_ENABLED=true
# DERIVED_RUN_HOUR=6

# --- Insights (Claude) ---
# Empty key => the LLM-backed routes return 503 and the rest of the app is unaffected.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_DAILY_TOKEN_CAP=50000

# WHOOP OAuth credentials (from the WHOOP Developer Dashboard)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered on the dashboard.
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# Usually no need to change these:
WHOOP_AUTHORIZE_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_API_BASE=https://api.prod.whoop.com/developer/v2
WHOOP_SCOPES=read:recovery read:cycles read:sleep read:workout read:profile read:body_measurement offline

# --- Mill Sense (indoor air quality) ---
# Uses your Mill app account login (no OAuth / API keys).
MILL_USERNAME=
MILL_PASSWORD=
# MILL_API_BASE=https://api.millnorwaycloud.com

# Optional in-app poller (builds the overnight time series automatically).
# MILL_POLL_ENABLED=true
# MILL_POLL_INTERVAL_SECONDS=300
# MILL_POLL_START_HOUR=22   # only poll 22:00..08:00 (wraps midnight); omit both to poll 24/7
# MILL_POLL_END_HOUR=8
